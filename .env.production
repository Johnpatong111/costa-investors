# ---------------------------------------------------------------------------
# PRODUKCJA – domena kanoniczna (bez ukośnika na końcu)
# ---------------------------------------------------------------------------
# Ten plik jest wczytywany przez `next build` / `next start` w NODE_ENV=production.
# NEXT_PUBLIC_* jest wstrzykiwany do bundla klienta, więc canonical, hreflang,
# JSON-LD, sitemapa i og:image zawsze wskazują domenę produkcyjną.
NEXT_PUBLIC_SITE_URL="https://costainvestors.eu"

# i18n – trasy /pl, /en, /es są wdrożone.
I18N_ROUTING_ENABLED="true"

# Poczta transakcyjna (uzupełnij klucz w panelu hostingu/CI, nie w repo).
LEAD_EMAIL_FROM="leady@costainvestors.eu"
