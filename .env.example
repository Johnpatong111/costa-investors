# ---------------------------------------------------------------------------
# PUBLICZNE
# ---------------------------------------------------------------------------
# Bazowy adres kanoniczny (bez ukośnika na końcu). Wymagany na produkcji.
NEXT_PUBLIC_SITE_URL="https://costainvestors.eu"

# ---------------------------------------------------------------------------
# DYSTRYBUCJA LEADÓW (sekcja 5)
# ---------------------------------------------------------------------------
# Główny webhook partnera CRM (Make / n8n / własny endpoint).
LEADS_WEBHOOK_URL=""
# Routing per język: dedykowany endpoint dla leadów EN / ES
# (agent posługujący się danym językiem). Puste = fallback do LEADS_WEBHOOK_URL.
LEADS_WEBHOOK_URL_EN=""
LEADS_WEBHOOK_URL_ES=""
# Sekret do podpisu HMAC-SHA256 nagłówka `x-lead-signature`.
LEADS_WEBHOOK_SECRET=""

# Alternatywne kanały (opcjonalne, mogą działać równolegle).
ZAPIER_HOOK_URL=""
MAKE_HOOK_URL=""
# Webhook do bramki SMS (Twilio / SMSAPI / Vonage) – treść JSON buduje nasz kod.
LEAD_SMS_WEBHOOK_URL=""
LEAD_SMS_WEBHOOK_TOKEN=""

# E-mail transakcyjny (Resend).
RESEND_API_KEY=""
LEAD_NOTIFY_EMAIL=""
LEAD_EMAIL_FROM="leady@costainvestors.eu"

# ---------------------------------------------------------------------------
# ANTYS PAM / LIMITY
# ---------------------------------------------------------------------------
# Limit requestów na IP na endpoint /api/leads (na proces).
LEAD_RATE_LIMIT="6"
LEAD_RATE_WINDOW_MS="600000"

# ---------------------------------------------------------------------------
# i18n
# ---------------------------------------------------------------------------
# Trasy app/[lang]/... są wdrożone – routing językowy MUSI być włączony,
# inaczej middleware nie ustawi x-locale i nie obsłuży 308 na aliasach.
I18N_ROUTING_ENABLED="true"
